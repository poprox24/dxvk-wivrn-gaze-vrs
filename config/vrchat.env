# Working VRChat configuration from the October 2026 test.
# Put these in Steam's VRChat launch options as:
#   env DXVK_GAZE_VRS=1 ... %command%
# or export them in the environment that launches VRChat.

DXVK_GAZE_VRS=1

# VRChat's tested HDR scene pass: Vulkan format 97 (RGBA16F).
# This avoids applying VRS to later/final passes and depth-only passes.
DXVK_GAZE_FMT=97

# The tested scene-pass coordinate orientation is vertically flipped.
DXVK_GAZE_FLIP_Y=1

# Initial tested foveation shape.
DXVK_GAZE_R1=0.06
DXVK_GAZE_R2=0.12
DXVK_GAZE_COARSE=5

# Optional diagnostics:
# DXVK_GAZE_DEBUG=1
# DXVK_GAZE_DOT=1
# DXVK_GAZE_DOT_RADIUS=24

# Recommended setup for VRChat:
DXVK_GAZE_VRS=1 DXVK_GAZE_FMT=97 DXVK_GAZE_FLIP_Y=1 DXVK_GAZE_R1=0.5 DXVK_GAZE_R2=0.65 DXVK_GAZE_COARSE=5