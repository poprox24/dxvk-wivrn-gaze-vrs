+// ADDED: gaze export for the DXVK gaze-VRS experiment.
+// Layout must match DxvkGazeVrs::GazeShm in dxvk_gaze_vrs.h.
+namespace
+{
+struct gaze_shm_data
+{
+	uint32_t magic;
+	uint32_t seq;
+	float cx[2];
+	float cy[2];
+	uint32_t valid;
+};
+
+gaze_shm_data * open_gaze_shm()
+{
+	static gaze_shm_data * ptr = []() -> gaze_shm_data * {
+		int fd = open("/dev/shm/wivrn_gaze", O_RDWR | O_CREAT | O_CLOEXEC, 0666);
+		if (fd < 0)
+			return nullptr;
+		if (ftruncate(fd, 64) < 0)
+		{
+			close(fd);
+			return nullptr;
+		}
+		void * m = mmap(nullptr, 64, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+		close(fd);
+		if (m == MAP_FAILED)
+			return nullptr;
+		return static_cast<gaze_shm_data *>(m);
+	}();
+	return ptr;
+}
+
+void export_gaze(const float cx[2], const float cy[2], bool valid)
+{
+	auto * s = open_gaze_shm();
+	if (not s)
+		return;
+
+	auto * seq = reinterpret_cast<std::atomic<uint32_t> *>(&s->seq);
+	uint32_t v = seq->load(std::memory_order_relaxed);
+	seq->store(v + 1, std::memory_order_release); // odd = writing
+	s->magic = 0x455a4147u;
+	for (int i = 0; i < 2; ++i)
+	{
+		s->cx[i] = cx[i];
+		s->cy[i] = cy[i];
+	}
+	s->valid = valid;
+	seq->store(v + 2, std::memory_order_release);
+}
+} // namespace
